# ─────────────────────────────────────────────────────────────
# TRADE-DESK 環境變數範本
#   1. 複製成 router/.env      Copy-Item router\.env.example router\.env
#   2. 逐項填入（不要留 <> 佔位符）
#   3. 收緊權限            icacls router\.env /inheritance:r /grant:r "$env:USERNAME:(R,W)"
#   .env 已在 .gitignore；本檔（.env.example）不得填入任何真實值。
# ─────────────────────────────────────────────────────────────

# ── Owner 與伺服器（Discord 開發者模式 → 右鍵複製 ID）────────────
OWNER_USER_ID=                 # 你的 Discord User ID（右鍵你的頭像 → 複製使用者 ID）
GUILD_ID=                      # 伺服器 ID（右鍵伺服器圖示 → 複製伺服器 ID）

# ── 16 隻 Bot 的 token（Discord Developer Portal → Bot → Reset Token）──
# Day 0 只需填前兩個；其餘 14 隻建好後再補，補完重啟 Router。
DISCORD_TOKEN_ROUTER=
DISCORD_TOKEN_CEO=
DISCORD_TOKEN_MACRO=
DISCORD_TOKEN_FEED=
DISCORD_TOKEN_LEDGER=
DISCORD_TOKEN_CHART=
DISCORD_TOKEN_RISK=
DISCORD_TOKEN_EXEC=
DISCORD_TOKEN_LAB=
DISCORD_TOKEN_REDTEAM=
DISCORD_TOKEN_AUDIT=
DISCORD_TOKEN_WATCH=
DISCORD_TOKEN_FORGE=
DISCORD_TOKEN_CMO=
DISCORD_TOKEN_CREATIVE=
DISCORD_TOKEN_GROWTH=

# ── 18 個頻道 ID（右鍵頻道 → 複製頻道 ID）──────────────────────
CH_HUMAN_INBOX=
CH_CEO_DAILY=
CH_MEETING_ROOM=
CH_TASKS=
CH_MACRO=
CH_MARKET_DATA=
CH_ANALYSIS=
CH_RISK=
CH_EXECUTION=
CH_JOURNAL=
CH_BACKTEST=
CH_FORGE=
CH_MARKETING=
CH_MARKETING_REVIEW=
CH_GROWTH=
CH_AGENT_HEALTH=
CH_AUDIT_LOG=
CH_ALERTS=

# ── Bitget（先用 DEMO；key 權限只勾「合約交易」，務必不要勾提幣）──
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
BITGET_DEMO=1                  # 1 = 模擬盤；轉真錢時才改 0，且必須換成正式 key
BITGET_IP_WHITELIST=           # 選填：綁定的對外 IP（家用浮動 IP 變動時會靜默 401）

# ── 資料倉寫入 token（engine/ingest_server.py 驗證，每個寫入程式一組）──
INGEST_TOKEN_FEED=
INGEST_TOKEN_EXEC=
INGEST_TOKEN_AUDIT=
INGEST_TOKEN_LEDGER=
INGEST_TOKEN_MACRO=
INGEST_TOKEN_MARKETING=

# ── 行銷（Phase 7 才需要）──────────────────────────────────
META_APP_ID=
META_APP_SECRET=
IG_USER_ID=
IG_LONG_LIVED_TOKEN=           # 60 天到期，GROWTH 會提前 7 天提醒
IMAGE_HOST_BASE_URL=           # IG 發佈需要公開可讀的圖片網址

# ── 系統 ───────────────────────────────────────────────────
CLAUDE_BIN=claude              # claude 執行檔路徑（不在 PATH 時填絕對路徑）
# TZ 僅供參考。**交易時區的真相在 router/scheduler.yaml 的 timezone 欄位**，
# 排程與日誌時間戳都用那個，不看這一行、也不看作業系統。
# （Windows 的 C 執行庫不認得 "Asia/Taipei" 這種 IANA 名稱，設了反而可能讓
#   本機時間退回 UTC——那就是「日誌 17:03、排程說 01:03+08:00」的來源。）
TZ=Asia/Taipei
DASHBOARD_PORT=8080
INGEST_PORT=8787

# ── 隔離層級 ──────────────────────────────────────────────────
# 0 = 原生 Windows（預設）。沒有 OS 層沙箱，隔離靠 L1 工具層 + L2 worktree + L3 偵測還原。
# 1 = macOS / Linux / WSL2。要求 OS 層沙箱，起不來的呼叫直接失敗。
#     設 1 之前先在該環境跑：sudo apt-get install bubblewrap socat
# 完整差異見 docs/12_DIGITAL_BOUNDARY.md
TD_REQUIRE_SANDBOX=0
